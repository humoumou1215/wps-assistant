{
  "name": "wps-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humoumou1215/wps-mcp.git"
  },
  "bugs": "https://github.com/humoumou1215/wps-mcp/issues",
  "homepage": "https://github.com/humoumou1215/wps-mcp#readme",
  "description": "MCP bridge for live WPS Office documents and WPS JavaScript API",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-js.mjs",
    "test:ci": "npm run build && node --test --test-timeout=120000 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results.xml test/*.test.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:wps-live": "bash scripts/run-macos-wps-live-tests.sh",
    "test:wps-writer-live": "bash scripts/run-macos-wps-writer-live-test.sh",
    "install:addin": "node scripts/install-addin.mjs",
    "uninstall:addin": "node scripts/install-addin.mjs --uninstall",
    "debug:local": "node scripts/debug-local.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "acorn": "^8.18.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
