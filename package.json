{
  "name": "wps-mcp",
  "version": "0.1.22",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humoumou1215/wps-assistant.git"
  },
  "bugs": "https://github.com/humoumou1215/wps-assistant/issues",
  "homepage": "https://github.com/humoumou1215/wps-assistant#readme",
  "description": "MCP bridge for live WPS Office documents and WPS JavaScript API",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "node scripts/sync-version.mjs --check && tsc -p tsconfig.json --noEmit && node scripts/check-js.mjs",
    "test:ci": "npm run build && node --test --test-timeout=120000 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results.xml test/*.test.mjs",
    "install:macos": "bash scripts/install-macos.sh",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "build:portable": "node desktop/build-portable.mjs",
    "icons:export": "node desktop/export-icons.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acorn": "^8.19.0",
    "saxes": "6.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "linkedom": "^0.18.14",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
